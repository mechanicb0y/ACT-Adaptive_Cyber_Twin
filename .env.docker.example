# Copy to .env (repo root) before `docker compose up`. Compose reads this file
# automatically. This is separate from backend/.env (used for non-Docker runs).

# ---- Postgres --------------------------------------------------------------
POSTGRES_USER=act
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=act

# ---- ACT backend --------------------------------------------------------
ACT_ENV=production
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACT_JWT_SECRET=
ACT_AUTH_ENABLED=true
ACT_ADMIN_USERNAME=admin
# Leave blank to have a random admin password generated and printed to the log
# (docker compose logs act-backend). Change it after first sign-in.
ACT_ADMIN_PASSWORD=

# Browser origin the dashboard is served from (the frontend container).
ACT_CORS_ORIGINS=http://localhost:8080
# Gate /api/metrics for your Prometheus scraper (optional).
ACT_METRICS_TOKEN=

# ---- Ports published on the host -------------------------------------------
ACT_HTTP_PORT=8080
PGADMIN_PORT=5050

# ---- pgadmin (only with --profile tools) ----------------------------------
PGADMIN_EMAIL=admin@act.local
PGADMIN_PASSWORD=admin

# ---- Local LLM (only with --profile ai) ----------------------------------
# ACT_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://ollama:11434

# ---- Critical alerts (optional) -----------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
