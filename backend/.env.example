# ACT environment — copy to backend/.env and edit. Every value has a safe
# default; a fresh checkout runs with this file empty. backend/.env is
# git-ignored.

# ─────────────────────────────────────────────────────────────── runtime ──
# development | production   (production tightens defaults in later phases)
ACT_ENV=development
ACT_HOST=127.0.0.1
ACT_PORT=8000

# ────────────────────────────────────────────────────────────── database ──
# Unset  -> SQLite at backend/data/act.db (no setup, good for dev + tests).
# Postgres example (needs `psycopg[binary]`, see requirements.txt):
#   DATABASE_URL=postgresql+psycopg://act:act@localhost:5432/act
# DATABASE_URL=
# ACT_DB_POOL_SIZE=5
# ACT_DB_MAX_OVERFLOW=10
# ACT_DB_POOL_RECYCLE=1800
# ACT_DB_CONNECT_RETRIES=5          # retries while the DB container starts up
# ACT_DB_CONNECT_RETRY_BACKOFF=0.5  # seconds, doubles each attempt (cap 10s)
# ACT_DB_ECHO=false

# ─────────────────────────────────────────────────────────────── logging ──
# ACT_LOG_LEVEL=INFO
# ACT_LOG_FORMAT=console            # console | json  (json for journald/Docker)
# ACT_LOG_FILE=                     # also write a rotating JSON file here
# ACT_LOG_FILE_MAX_BYTES=10485760
# ACT_LOG_FILE_BACKUP_COUNT=5

# ─────────────────────────────────────────────────── SSL / HTTPS (later) ──
# ACT_SSL_ENABLED=false
# ACT_SSL_CERT=/etc/act/tls/fullchain.pem
# ACT_SSL_KEY=/etc/act/tls/privkey.pem
# ACT_FORCE_HTTPS=false

# ───────────────────────────────────────────── local AI / RAG (existing) ──
OLLAMA_MODEL=llama3.2
# OLLAMA_PATH=
# ACT_LLM_PROVIDER=ollama
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ──────────────────────────────────────────── critical alerts (existing) ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ─────────────────────────── auth / OAuth2 / SMTP / Sentry — later phases ──
# ACT_JWT_SECRET=
# ACT_OAUTH_GOOGLE_CLIENT_ID=
# ACT_OAUTH_GOOGLE_CLIENT_SECRET=
# ACT_OAUTH_GITHUB_CLIENT_ID=
# ACT_OAUTH_GITHUB_CLIENT_SECRET=
# ACT_SMTP_HOST=
# SENTRY_DSN=
