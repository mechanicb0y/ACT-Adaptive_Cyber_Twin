# ACT environment — copy to backend/.env and edit. Every value has a safe
# default; a fresh checkout runs with this file empty. backend/.env is
# git-ignored.

# ─────────────────────────────────────────────────────────────── runtime ──
# development | production   (production tightens defaults in later phases)
ACT_ENV=development
ACT_HOST=127.0.0.1
ACT_PORT=8000

# ────────────────────────────────────────────────────────────── database ──
# Unset  -> SQLite at backend/data/act.db (no setup, good for dev + tests).
# Postgres example (needs `psycopg[binary]`, see requirements.txt):
#   DATABASE_URL=postgresql+psycopg://act:act@localhost:5432/act
# DATABASE_URL=
# ACT_DB_POOL_SIZE=5
# ACT_DB_MAX_OVERFLOW=10
# ACT_DB_POOL_RECYCLE=1800
# ACT_DB_CONNECT_RETRIES=5          # retries while the DB container starts up
# ACT_DB_CONNECT_RETRY_BACKOFF=0.5  # seconds, doubles each attempt (cap 10s)
# ACT_DB_ECHO=false

# ─────────────────────────────────────────────────────────────── logging ──
# ACT_LOG_LEVEL=INFO
# ACT_LOG_FORMAT=console            # console | json  (json for journald/Docker)
# ACT_LOG_FILE=                     # also write a rotating JSON file here
# ACT_LOG_FILE_MAX_BYTES=10485760
# ACT_LOG_FILE_BACKUP_COUNT=5

# ─────────────────────────────────────────────────────────── SSL / HTTPS ──
# `--mode service` starts uvicorn with TLS when this is on.
# ACT_SSL_ENABLED=false
# PEM paths. If unset and ACT_ENV != production, ACT generates a self-signed
# pair in backend/data/tls/ (needs openssl). In production, unset = refuse.
# ACT_SSL_CERT=/etc/letsencrypt/live/act.example.com/fullchain.pem
# ACT_SSL_KEY=/etc/letsencrypt/live/act.example.com/privkey.pem
# Redirect plaintext http:// to https:// (honours X-Forwarded-Proto; never
# redirects /api/health). Safe to enable behind a TLS-terminating proxy.
# ACT_FORCE_HTTPS=false

# ────────────────────────────────────────────────────────────────── CORS ──
# Comma-separated origin allowlist for the browser API. Empty -> localhost dev
# origins only. "*" is honoured (with a warning) and disables credentials.
# ACT_CORS_ORIGINS=https://act.example.com
# ACT_CORS_ALLOW_CREDENTIALS=false

# ─────────────────────────────────────────────────────── Host header ──
# Allowlist for the HTTP Host header. "*" (default) accepts any host. In
# PRODUCTION set this so a forged Host cannot poison password-reset links etc.
# Leading "." allows subdomains. /api/health is always exempt (IP probes).
# ACT_ALLOWED_HOSTS=act.example.com,.act.example.com

# ──────────────────────────────────────────────────────── rate limiting ──
# Per client IP, fixed 60s window, in-process (multiplies by worker count).
# ACT_RATE_LIMIT_ENABLED=true
# ACT_RATE_LIMIT_PER_MIN=240          # general /api bucket
# ACT_RATE_LIMIT_AUTH_PER_MIN=12      # /api/auth/login + /refresh bucket
# ACT_TRUST_FORWARDED_FOR=false       # only behind a proxy you control

# ─────────────────────────────────────────────────────────────── metrics ──
# ACT_METRICS_ENABLED=true
# ACT_METRICS_TOKEN=                  # if set, /api/metrics needs ?token= or bearer

# ──────────────────────────────────────────────────────────── persistence ──
# Mirror pipeline output (events/behaviours/paths/responses) into the database.
# ACT_PERSIST_ENABLED=true

# ────────────────────────────────────── tracing / errors (optional extras) ──
# Needs: pip install -r requirements-observability.txt
# ACT_OTEL_ENABLED=false
# ACT_OTEL_SERVICE_NAME=act
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # HTTP; else console
# ACT_OTEL_CONSOLE=false
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ─────────────────────────────────────────────────────── email (SMTP) ──
# Used for password-reset links and, if enabled, critical-attack alerts.
# ACT_SMTP_HOST=smtp.example.com
# ACT_SMTP_PORT=587
# ACT_SMTP_USERNAME=
# ACT_SMTP_PASSWORD=
# ACT_SMTP_FROM=act@example.com
# ACT_SMTP_STARTTLS=true
# ACT_SMTP_SSL=false
# ACT_EMAIL_ALERTS=false
# ACT_ALERT_EMAIL_TO=soc@example.com
# ACT_PASSWORD_RESET_TTL_MIN=30
# Public URL used to build links in emails. REQUIRED in production for the
# password-reset flow - the link base is never taken from the request Host.
# ACT_PUBLIC_BASE_URL=https://act.example.com

# ───────────────────────────────────────────── local AI / RAG (existing) ──
OLLAMA_MODEL=llama3.2
# OLLAMA_PATH=
# ACT_LLM_PROVIDER=ollama
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ──────────────────────────────────────────── critical alerts (existing) ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ────────────────────────────────────────────────────────── authentication ──
# On by default: every /api route needs a bearer token except /api/auth/* and
# /api/health. Set to false for the old single-user prototype (no login).
# ACT_AUTH_ENABLED=true
#
# REQUIRED in production: a long random string. Without it a per-process secret
# is generated and sessions die on restart / are not shared across workers.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ACT_JWT_SECRET=
# ACT_ACCESS_TOKEN_TTL_MIN=30
# ACT_REFRESH_TOKEN_TTL_DAYS=7
# ACT_REFRESH_TOKEN_REMEMBER_DAYS=30
#
# First-run admin. If the password is unset, one is generated and written to the
# log once. Change it after first login.
# ACT_ADMIN_USERNAME=admin
# ACT_ADMIN_PASSWORD=

# ───────────────────────────── OAuth2 (optional; inert unless id + secret) ──
# ACT_OAUTH_GOOGLE_CLIENT_ID=
# ACT_OAUTH_GOOGLE_CLIENT_SECRET=
# ACT_OAUTH_GITHUB_CLIENT_ID=
# ACT_OAUTH_GITHUB_CLIENT_SECRET=
# Public base URL for building the OAuth callback (defaults to the request host):
# ACT_OAUTH_REDIRECT_BASE_URL=https://act.example.com
# Restrict first-time OAuth sign-ins to these email domains (comma-separated):
# ACT_OAUTH_ALLOWED_DOMAINS=example.com
# ACT_OAUTH_DEFAULT_ROLE=viewer

# ───────────────────────────────────────── SMTP / Sentry — later phases ──
# ACT_SMTP_HOST=
# SENTRY_DSN=
